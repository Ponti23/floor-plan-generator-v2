{
  "name": "floorplan-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "benchmark:worker": "node scripts/benchmark-worker.mjs",
    "benchmark:stage0": "node scripts/benchmark-stage0.mjs",
    "benchmark:stage0:check": "node scripts/benchmark-stage0.mjs --check",
    "benchmark:stage0:bounded": "node scripts/benchmark-stage0.mjs --check --bounded",
    "diagnostics:canonical": "node scripts/inspect-canonical.mjs",
    "contracts:export": "E:/Projects/floor-plan-model/.python/python.exe scripts/export-generation-contract.py",
    "contracts:check": "E:/Projects/floor-plan-model/.python/python.exe scripts/export-generation-contract.py --check",
    "test:service": "E:/Projects/floor-plan-model/.python/python.exe -m unittest discover -s services/generation/tests/unit -p test_*.py",
    "test:integration": "node --test \"test/integration/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  }
}
