# PlanLab generation service — example configuration (names and defaults only).
#
# Copy to .env.generation.local (git-ignored) and adjust only if your machine
# differs. The startup scripts read this file with a strict KEY=VALUE parser and
# never execute its contents. NO SECRETS BELONG HERE: the service is loopback
# only and holds no API keys.
#
# The existing .env.local holds an unrelated provider key. It is not read by the
# generation service and must not be repurposed for it.

# Absolute engine workspace; operator-only path.
PLANLAB_ENGINE_ROOT=E:/Projects/floor-plan-model

# Interpreter that owns torch / OR-Tools. Never the overlay.
PLANLAB_PYTHON=E:/Projects/floor-plan-model/.python/python.exe

# Service-only dependency overlay added to sys.path by the launch bootstrap.
PLANLAB_SERVICE_SITE_PACKAGES=E:/Projects/floorplan-generator/.runtime/generation/site-packages

# Model checkpoint and its pinned hash. A mismatch is MODEL_LOAD_FAILURE.
PLANLAB_CHECKPOINT=E:/Projects/floor-plan-model/topology_v1/checkpoints/full_v1a/best.pt
PLANLAB_CHECKPOINT_SHA256=3ea6225e6c582e167cb9a2450eae5b068cc2189cae182cb015503e3d47e220d8

# Durable data: SQLite database, backups and the runtime service lock.
PLANLAB_DATA_DIR=E:/Projects/floorplan-generator/.local/planlab
PLANLAB_LOG_DIR=E:/Projects/floorplan-generator/.local/planlab/logs

# Release mode serves the built frontend from here; dev mode uses Vite instead.
PLANLAB_STATIC_DIR=E:/Projects/floorplan-generator/dist

# Loopback only for this MVP. A non-loopback value must fail startup.
PLANLAB_HOST=127.0.0.1
PLANLAB_PORT=8010

# Vite dev origins allowed to call the API (dev only).
PLANLAB_DEV_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Solver concurrency: 8 search workers, exactly 1 active job.
PLANLAB_SOLVER_WORKERS=8
PLANLAB_MAX_ACTIVE_JOBS=1

# Server-only wall deadline for an active job, in seconds.
PLANLAB_JOB_DEADLINE_S=360

# 0 disables the debug route and panel.
PLANLAB_DEBUG=0
